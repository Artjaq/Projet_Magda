---
layout: base.njk
titre: "Tout au Chaud — Vêtements faits main en Suisse romande"
description: "Vêtements artisanaux faits à la main par Magda, en Suisse romande. Pièces uniques, matières naturelles, savoir-faire transmis."
pageActuelle: "accueil"
---

<main>

  {# ── HERO ──────────────────────────────────────────────────────────── #}
  <section class="hero" aria-label="Présentation de la marque">
    <div class="hero-contenu">
      <p class="hero-surtitre">{{ accueil.hero.surtitre }}</p>
      <h1 class="hero-titre">{{ accueil.hero.titre }}</h1>
      <p class="hero-tagline">{{ accueil.hero.tagline }}</p>
      <a href="/contact/" class="bouton-principal">{{ accueil.hero.bouton }}</a>
    </div>
  </section>


  {# ── GRILLE DE PIÈCES ──────────────────────────────────────────────── #}
  {# La collection "pieces" est triée par ordre croissant du champ "ordre"
     dans .eleventy.js. Pas besoin de trier ici. #}
  <section class="decouvrir" aria-labelledby="titre-decouvrir">
    <div class="contenu-max">

      <h2 id="titre-decouvrir" class="titre-section">{{ accueil.pieces.titre }}</h2>
      <p class="sous-titre-section">{{ accueil.pieces.sous_titre }}</p>

      <div class="carousel" role="region" aria-label="Pièces de la collection">
        <div class="carousel-piste" id="carousel-piste">
          {% for piece in collections.pieces %}
            <a href="/pieces/{{ piece.fileSlug }}/" class="piece-carte carousel-item">
              {% if piece.data.image %}
                <img class="piece-image" src="{{ piece.data.image }}" alt="{{ piece.data.titre }}">
              {% else %}
                <div class="piece-image img-placeholder" aria-hidden="true">
                  <span>{{ piece.data.description }}</span>
                </div>
              {% endif %}
              <span class="piece-legende">{{ piece.data.titre }}</span>
            </a>
          {% endfor %}
        </div>
        <div class="carousel-controles" aria-label="Navigation du carousel">
          <button class="carousel-fleche carousel-fleche--prev" aria-label="Pièce précédente">&#8592;</button>
          <button class="carousel-fleche carousel-fleche--next" aria-label="Pièce suivante">&#8594;</button>
        </div>
      </div>

    </div>
  </section>


  {# ── UN FIL CONDUCTEUR ─────────────────────────────────────────────── #}
  <section class="presentation" aria-labelledby="titre-presentation">
    <div class="contenu-max presentation-interieur">

      <div class="presentation-texte">
        <h2 id="titre-presentation" class="titre-section">{{ accueil.fil_conducteur.titre }}</h2>
        <p class="corps-texte">{{ accueil.fil_conducteur.texte }}</p>
        <a href="/apropos/" class="lien-discret">{{ accueil.fil_conducteur.lien_label }}</a>
      </div>

      {% if accueil.fil_conducteur.image %}
        <img class="presentation-visuel" src="{{ accueil.fil_conducteur.image }}"
             alt="Détail d'une couture réalisée à la main">
      {% else %}
        <div class="presentation-visuel img-placeholder" aria-hidden="true">
          <span>Photo&nbsp;: détail d'une couture<br>réalisée à la main</span>
        </div>
      {% endif %}

    </div>
  </section>

</main>
