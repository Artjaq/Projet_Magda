{# Pied de page commun à toutes les pages.
   Email et Instagram proviennent de src/_data/site.yaml. #}

<footer class="site-footer">
  <div class="footer-inner">

    <div class="footer-marque">
      <a href="/" class="logo">{{ site.nom }}</a>
      <p class="footer-slogan">{{ site.slogan }}</p>
    </div>

    <nav class="footer-nav" aria-label="Navigation secondaire">
      <a href="/">Accueil</a>
      <a href="/apropos/">À propos</a>
      <a href="/contact/">Contact</a>
    </nav>

    <div class="footer-contact">
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      <a href="{{ site.instagram }}" target="_blank" rel="noopener noreferrer">Instagram</a>
    </div>

  </div>
  <p class="footer-copyright">© 2025 {{ site.nom }} — Tous droits réservés</p>
</footer>
